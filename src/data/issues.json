          {
            "type": "link",
            "text": "【DBDR Master Series 季后赛】X9 CLAN vs Ariandel 第二轮【X9/官台解说双视角】",
            "href": "https://www.bilibili.com/video/BV1G5ng6KEvQ?spm_id_from=333.1387.homepage.video_card.click&vd_source=ac2b25f6c035592c1e94b2655f861a73"
          }
