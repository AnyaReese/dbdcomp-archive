---
import '../styles/global.css';
const { title = 'DBDCOMP 赛事简报档案', description = '非官方赛事简报整理站' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171311" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="返回首页">
        <span class="brand-mark">D</span>
        <span><strong>DBDCOMP</strong><small>赛事简报档案</small></span>
      </a>
      <nav aria-label="主导航">
        <a href={`${base}#issues`}>全部简报</a>
        <a href="https://space.bilibili.com/3546631626558260/dynamic" target="_blank" rel="noreferrer">作者主页 ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>经创作者联系授权整理 · 内容版权归原作者所有</p>
      <p>本站为非官方资料档案，每篇均保留 B 站原文链接。</p>
    </footer>
  </body>
</html>
